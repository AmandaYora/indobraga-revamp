# Salin ke .env lalu isi. JANGAN commit .env. Semua nilai rahasia di sini adalah placeholder.
# Pemetaan dari env legacy: knowledge/DEPLOYMENT.md §Env.

# --- App ---------------------------------------------------------------------
APP_ENV=development            # development | test | production
APP_NAME=indobraga
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error
# CIDR proxy tepercaya untuk X-Forwarded-For (Nginx). Kosong = abaikan header.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Folder build frontend yang disajikan Go (SPA shell). Kosong di dev: Vite yang menyajikan.
PUBLIC_DIR=

# --- Database (MySQL 8 di host, bukan Docker) -------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=indobraga
DB_PASSWORD=
DB_NAME=indobraga_revamp
# DSN Go (database/sql) — tanpa prefix skema. Di container: host.docker.internal.
DB_DSN=indobraga:@tcp(localhost:3306)/indobraga_revamp?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_unicode_ci
# Database test terpisah (dikosongkan & dimigrasi ulang oleh test).
DB_TEST_DSN=indobraga:@tcp(localhost:3306)/indobraga_revamp_test?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_unicode_ci

# --- Auth & secret (ADR-0006) — wajib ≥ 32 karakter acak di produksi ----------------
SESSION_COOKIE_NAME=indobraga_admin_session
SESSION_SECRET=replace-with-random-32-bytes-or-more
ADMIN_SESSION_TTL_DAYS=7
CSRF_COOKIE_NAME=indobraga_csrf
CREDENTIAL_ENCRYPTION_KEY=replace-with-random-32-bytes-or-more
INTERNAL_WORKER_SECRET=replace-with-random-16-bytes-or-more

# --- URL publik ---------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_MEDIA_URL=http://localhost:8080/media-local

# --- Upload & media (ADR-0008) --------------------------------------------------
UPLOAD_IMAGE_MAX_MB=10
UPLOAD_VIDEO_MAX_MB=100
MEDIA_THUMBNAIL_MAX_WIDTH=480
MEDIA_MEDIUM_MAX_WIDTH=960
MEDIA_LARGE_MAX_WIDTH=1600
MEDIA_OBJECT_PREFIX=upload
MEDIA_STORAGE_ENV=dev          # dev | staging | prod
MEDIA_PATH_TIME_ZONE=Asia/Jakarta

# --- Storage ------------------------------------------------------------------
STORAGE_DRIVER=local           # local | s3 (produksi wajib s3)
STORAGE_LOCAL_ROOT=storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email & worker kampanye -----------------------------------------------------
EMAIL_PROVIDER_MODE=mock       # mock | live
SMTP_TEST_TIMEOUT_MS=10000
EMAIL_CAMPAIGN_RECIPIENT_MAX=1000
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_WORKER_MAX_ATTEMPTS=3
EMAIL_WORKER_POLL_MS=60000
EMAIL_WORKER_STALE_MS=300000

# --- Notifikasi -----------------------------------------------------------------
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_SENDER=
NOTIFICATION_WORKER_POLL_MS=60000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_MAX_ATTEMPTS=3
NOTIFICATION_STREAM_HEARTBEAT_MS=30000

# --- Google OAuth (Gmail send) ----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/oauth/google/email/callback

# --- Seed (cmd/seed) — wajib diisi saat seeding, tidak ada default (BC-07) ---------------
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_CONTENT_EDITOR_NAME=
SEED_CONTENT_EDITOR_EMAIL=
SEED_CONTENT_EDITOR_PASSWORD=

# --- Frontend (prefix VITE_) --------------------------------------------------------
# Kosong = same-origin (Vite proxy di dev, satu container di produksi).
VITE_API_BASE_URL=
VITE_CSRF_COOKIE_NAME=indobraga_csrf
# Target proxy /api saat `npm run dev:web`.
VITE_DEV_API_TARGET=http://localhost:8080
# true = frontend memakai mock MSW berbasis kontrak (PLAN-02).
VITE_API_MOCK=false
