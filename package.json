{
  "name": "indobraga",
  "private": true,
  "version": "0.1.0",
  "description": "Indobraga — company profile, dashboard admin, dan API (Dimas Monorepo Standard, backend Go).",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @indobraga/web",
    "dev:api": "node scripts/dev-api.mjs",
    "build:web": "npm run build -w @indobraga/web",
    "build:api": "cd apps/api && go build -trimpath -o ../../dist/api ./cmd/server",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down 1",
    "migrate:create": "cd apps/api && migrate create -ext sql -dir migrations -seq",
    "sqlc:generate": "cd apps/api && sqlc generate",
    "sqlc:check": "node scripts/sqlc-check.mjs",
    "contract:bundle": "npm run bundle -w @indobraga/api-contract",
    "contract:lint": "npm run lint -w @indobraga/api-contract",
    "contract:generate": "npm run generate -w @indobraga/api-contract",
    "lint:web": "npm run lint -w @indobraga/web",
    "lint:api": "cd apps/api && golangci-lint run ./...",
    "typecheck:web": "npm run typecheck -w @indobraga/web",
    "test:web": "npm run test -w @indobraga/web",
    "test:api": "cd apps/api && go test ./...",
    "vuln:api": "cd apps/api && govulncheck ./...",
    "e2e:web": "npm run e2e -w @indobraga/web"
  }
}
