{
  "name": "@indobraga/api-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Kontrak API v1 Indobraga (OpenAPI 3.1) — sumber kebenaran antarmuka web ↔ api.",
  "type": "module",
  "types": "./generated/schema.d.ts",
  "exports": {
    ".": {
      "types": "./generated/schema.d.ts"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "legacy:scan": "node scripts/legacy-endpoints.mjs",
    "build:content": "node scripts/build-content-paths.mjs",
    "validate:fragment": "node scripts/validate-fragment.mjs",
    "assemble": "node scripts/assemble.mjs",
    "bundle": "node scripts/assemble.mjs && redocly bundle src/openapi.yaml -o openapi.yaml --config redocly.yaml",
    "lint": "redocly lint openapi.yaml --config redocly.yaml",
    "generate": "openapi-typescript openapi.yaml -o generated/schema.d.ts",
    "check": "node scripts/check-mapping.mjs",
    "build": "npm run bundle && npm run lint && npm run check && npm run generate"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "openapi-typescript": "^7.9.0",
    "yaml": "^2.8.0"
  }
}
