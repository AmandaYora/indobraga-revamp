{
  "name": "@indobraga/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_API_MOCK=true vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check src scripts index.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
